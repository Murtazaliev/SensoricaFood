@model AVBDelivery.Models.Settings
@{
    ViewBag.Title = "Настройки";
}

<h1>Настройки</h1>
<div asp-validation-summary="All" class="text-danger"></div>
@if (Model != null && !string.IsNullOrEmpty(Model.ApiKey))
{
    <h3 class="text-success">Ключ введен</h3>
}
else
{
    <h3 class="text-danger">Ключ отсутствует</h3>
}
<form asp-action="Save" method="post" asp-controller="Settings">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="ApiKey" class="control-label">Ключ AMO Crm</label>
        <input type="password" asp-for="ApiKey" class="form-control" />
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
    </div>
</form>