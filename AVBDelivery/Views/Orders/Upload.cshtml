@model AVBDelivery.ViewModels.OrderUploadPreviewViewModel

@{
    ViewData["Title"] = "Загрузка заказа из файла";
}

<h1>Загрузка заказа из файла</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

@if (Model.OrderGroups == null || Model.OrderGroups.Count == 0)
{
    <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="file" class="form-label">Выберите xlsx-файл заказа</label>
                            <input type="file" class="form-control" id="file" name="file" accept=".xlsx" required />
                        </div>
                        <button type="submit" class="btn btn-primary" id="uploadBtn" disabled>
                            <span class="spinner-border spinner-border-sm d-none" id="uploadSpinner" role="status"></span>
                            Загрузить
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
else
{
    <div class="mb-3">
        <span class="badge bg-secondary">Лист: @Model.SheetName</span>
        @if (Model.UnmatchedNames.Count > 0)
        {
            <span class="badge bg-danger">Не найдено в базе: @Model.UnmatchedNames.Count</span>
        }
    </div>

    @if (Model.UnmatchedNames.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>Товары, не найденные в базе данных:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var name in Model.UnmatchedNames)
                {
                    <li>@name</li>
                }
            </ul>
        </div>
    }

    <form asp-action="ConfirmUpload" method="post" id="confirmForm">
        @foreach (var group in Model.OrderGroups)
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        @if (group.OrganizationFound)
                        {
                            <i class="mdi mdi-check-circle text-success"></i>
                        }
                        else
                        {
                            <i class="mdi mdi-alert-circle text-danger"></i>
                        }
                        @group.ColumnHeader
                    </h5>
                    @if (group.OrganizationFound)
                    {
                        <span class="badge bg-success">Организация: @group.OrganizationName</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Организация не найдена</span>
                    }
                </div>
                <div class="card-body">
                    @if (group.OrganizationFound)
                    {
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Название из файла</th>
                                    <th>Товар в базе</th>
                                    <th>Цена</th>
                                    <th>Кол-во</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.Items.Where(i => i.Quantity > 0))
                                {
                                    <tr class="@(item.IsFound ? "" : "table-danger")">
                                        <td>@item.FileName</td>
                                        <td>
                                            @if (item.IsFound)
                                            {
                                                <span class="text-success">@item.ProductName</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">Не найден</span>
                                            }
                                        </td>
                                        <td>@(item.IsFound ? $"{item.Price} ₽" : "-")</td>
                                        <td>@item.Quantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Организация не найдена по комментарию «@group.ColumnHeader». Заказ для этой локации не будет создан.</p>
                    }
                </div>
            </div>
        }

        <div class="text-center">
            <a asp-action="Upload" class="btn btn-secondary me-2">Загрузить другой файл</a>
            <button type="submit" class="btn btn-primary btn-lg"
                    @(Model.OrderGroups.Any(g => g.OrganizationFound && g.Items.Any(i => i.IsFound && i.Quantity > 0)) ? "" : "disabled")>
                <span class="spinner-border spinner-border-sm d-none" id="confirmSpinner" role="status"></span>
                Создать заказы
            </button>
        </div>
    </form>
}

@section Scripts {
    <style>
        .loading-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        .loading-overlay.active {
            display: flex;
        }
        .loading-overlay .overlay-content {
            background: #1e2130;
            border: 1px solid #313548;
            border-radius: 12px;
            padding: 2rem 3rem;
            text-align: center;
            color: #b8c0d1;
        }
        .loading-overlay .spinner-border {
            width: 3rem;
            height: 3rem;
            color: #f0c040;
        }
    </style>

    <div id="uploadOverlay" class="loading-overlay">
        <div class="overlay-content">
            <div class="spinner-border mb-3" role="status"></div>
            <p class="mb-0 fw-semibold">Загрузка и парсинг файла...</p>
            <small class="text-muted">Поиск товаров и организаций в базе</small>
        </div>
    </div>

    <div id="confirmOverlay" class="loading-overlay">
        <div class="overlay-content">
            <div class="spinner-border mb-3" role="status"></div>
            <p class="mb-0 fw-semibold">Создание заказов...</p>
            <small class="text-muted">Отправка в amoCRM</small>
        </div>
    </div>

    <script>
        (function () {
            var fileInput = document.getElementById('file');
            var uploadBtn = document.getElementById('uploadBtn');
            if (fileInput && uploadBtn) {
                fileInput.addEventListener('change', function () {
                    uploadBtn.disabled = !fileInput.files.length;
                });
            }

            function bindForm(formId, overlayId) {
                var form = document.getElementById(formId);
                var overlay = document.getElementById(overlayId);
                if (form && overlay) {
                    form.addEventListener('submit', function () {
                        overlay.classList.add('active');
                        form.querySelectorAll('button, input[type="text"], input[type="number"], input[type="email"], input[type="password"], select, textarea').forEach(function (el) {
                            el.disabled = true;
                        });
                    });
                }
            }
            bindForm('uploadForm', 'uploadOverlay');
            bindForm('confirmForm', 'confirmOverlay');
        })();
    </script>
}
