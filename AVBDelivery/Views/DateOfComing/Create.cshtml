@model AVBDelivery.Models.DateOfComing

@{
    ViewData["Title"] = "Create";
}

<h1>Создать</h1>

<h4>Часы приёма заказов</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-controller="DateOfComing" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TimeOnly" class="control-label"></label>
                <input type="time" asp-for="TimeOnly" class="form-control" />
                <span asp-validation-for="TimeOnly" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Создать" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">К списку времени посещения</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
