@model AVBDelivery.Models.DateOfComing
@{
    ViewData["Title"] = "Edit";
}

<h1>Редактировать</h1>

<h4>Время посещения</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="TimeOnly" class="control-label"></label>
                <input type="time" asp-for="TimeOnly" class="form-control" />
                <span asp-validation-for="TimeOnly" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">К списку времени посещения</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
