@model AVBDelivery.ViewModels.EditUserViewModel

@{
    ViewBag.Title = "Редактирование пользователя";
}
<form asp-action="Edit" asp-controller="Users">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <input type="hidden" asp-for="Id" />
    </div>
    @if (Model.IsClient)
    {
        <div class="form-group">
            <label asp-for="Name" class="control-label">Имя</label>
            <input type="text" asp-for="Name" class="form-control" />
        </div>
    }
    
    <div class="form-group">
        <label asp-for="Email" class="control-label">Логин</label>
        <input type="text" asp-for="Email" class="form-control" />
    </div>
    @if (Model.IsClient)
    {
        <div class="form-group">
            <label asp-for="PhoneNumber" class="control-label">Телефон</label>
            <input type="tel" asp-for="PhoneNumber" class="form-control" />
        </div>
    }
   
    
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-outline-secondary" />
    </div>
</form>