
@model AVBDelivery.ViewModels.UsersViewModel;
@{
    ViewBag.Title = "Список пользователей";
}

<a class="btn btn-sm btn-primary" asp-action="Create">Добавить пользователя</a>


<table class="table">
    <tr><th>Имя</th><th>Логин</th><th>Существует в AmoCRM</th><th></th></tr>
    @if (Model.UsersWithClients != null){
        foreach (var user in Model.UsersWithClients)
        {
            <tr>
                <td>@user.Contact?.Name</td>
                <td>@user.User?.Email</td>
                <td>@(string.IsNullOrEmpty(user.Contact?.AmoCrmId) ? "Нет": "Да")</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@user.User.Id" method="post">
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@user.User.Id">Изменить</a>
                        <a class="btn btn-sm btn-primary" asp-action="ChangePassword" asp-route-id="@user.User.Id">Сменить пароль</a>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-controller="Roles" asp-route-userid="@user.User.Id">Права доступа</a>
                        <a class="btn btn-sm btn-primary" asp-action="Index" asp-controller="Organizations" asp-route-userid="@user.User.Id">Список организаций</a>
                        <button type="submit" class="btn btn-sm btn-danger">
                            Удалить
                        </button>
                    </form>
                </td>
            </tr>
        }
    }
    
</table>