@model List<AVBDelivery.Models.Menu>

@{
    ViewData["Title"] = "Меню";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Меню</h1>
    <a class="btn btn-primary" asp-action="Create">Создать меню</a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Название</th>
            <th>Товаров</th>
            <th>Активно</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var menu in Model)
            {
                <tr>
                    <td>@menu.Name</td>
                    <td>@menu.MenuProducts.Count</td>
                    <td>@(menu.IsActive ? "Да" : "Нет")</td>
                    <td class="text-end">
                        <form asp-action="Delete" asp-route-id="@menu.Id" method="post" onsubmit="return confirm('Удалить меню?');">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@menu.Id">Изменить</a>
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">Меню пока не созданы</td>
            </tr>
        }
    </tbody>
</table>
