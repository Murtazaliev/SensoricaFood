@model AVBDelivery.ViewModels.MenuViewModel

@{
    var actionName = Model.Id == null ? "Create" : "Edit";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form asp-action="@actionName" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <h3>Состав меню</h3>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCheckAll">Выбрать все</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnUncheckAll">Снять все</button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <tbody>
                                @foreach (var group in Model.Groups)
                                {
                                    <tr>
                                        <td colspan="3" class="fs-2">
                                            @group.GroupName
                                        </td>
                                    </tr>
                                    @foreach (var product in group.Products)
                                    {
                                        <tr>
                                            <td style="width: 40px; text-align: center;">
                                                <input class="form-check-input menu-product-check" type="checkbox"
                                                       name="ProductIds" value="@product.ProductId"
                                                       checked="@(product.IsSelected ? "checked" : null)" />
                                            </td>
                                            <td>@product.ProductName</td>
                                            <td>@product.Price ₽</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('btnCheckAll').addEventListener('click', function () {
        document.querySelectorAll('.menu-product-check').forEach(function (el) { el.checked = true; });
    });
    document.getElementById('btnUncheckAll').addEventListener('click', function () {
        document.querySelectorAll('.menu-product-check').forEach(function (el) { el.checked = false; });
    });
</script>
