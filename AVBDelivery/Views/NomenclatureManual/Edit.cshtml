@model AVBDelivery.ViewModels.CreateProductViewModel

@{
    ViewData["Title"] = "Редактировать";
}

<h1>Редактировать</h1>

<h4>Номенклатура</h4>
<hr />
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-6">
                        <form asp-action="Edit" asp-controller="NomenclatureManual">
                            <input type="hidden" asp-for="Product.Id" value="@Model.Product.Id" />

                            <div class="form-group">
                                <label for="projectName" class="form-label">Название:</label>
                                <input type="text" class="form-control" asp-for="Product.Name" placeholder="Введите название номенклатуры">
                            </div><!--end form-group-->
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-lg-9 col-9">
                                        <label class="form-label mt-2" asp-for="Product.ParentGroupName">Группа</label>
                                        <select class="form-select" asp-for="Product.ParentGroupName">
                                            @foreach (var item in Model.Groups)
                                            {
                                                if (item.Value == Model.Product.ParentGroupName)
                                                {
                                                    <option id="@item.Key" selected>@item.Value</option>
                                                }
                                                else
                                                {
                                                    <option id="@item.Key">@item.Value</option>
                                                }
                                            }
                                        </select>
                                    </div><!--end col-->
                                    <div class="col-lg-3 col-6 mb-2 mb-lg-0">
                                        <label class="form-label mt-2" asp-for="Product.Price">Цена</label>
                                        <input type="number" step="0.01" asp-for="Product.Price" class="form-control" />
                                    </div><!--end col-->
                                </div><!--end row-->
                            </div><!--end form-group-->
                            <div class="form-group mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input mt-2" type="checkbox" asp-for="Product.IsActive">
                                    <label class="form-check-label mt-2" asp-for="Product.IsActive">Включено в продажу</label>
                                </div>
                            </div><!--end form-group-->

                            <button type="submit" class="btn btn-de-primary btn-sm">Обновить</button>
                            <a class="btn btn-de-danger btn-sm" asp-action="Index">Отмена</a>
                        </form>  <!--end form-->
                    </div><!--end col-->
                    <div class="col-lg-5 ms-auto align-self-center">
                    </div><!--end col-->
                </div><!--end row-->
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end col-->
</div><!--end row-->

<div>
    <a asp-action="Index">К списку номенклатуры</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
