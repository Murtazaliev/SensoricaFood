@model AVBDelivery.ViewModels.DBLogViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Журнал событий</h1>
<div class=" row">
    <div class="@*col-sm-4*@">
        <div class="input-group" id="DateRange">
            <span class="input-group-text">Поиск</span>
            <input class="form-control" type="date" placeholder="Начальная дата" aria-label="StartDate" id="StartDate" style="max-width:150px">
            <span class="input-group-text">по</span>
            <input class="form-control" type="date" placeholder="Конечная дата" aria-label="EndDate" id="EndDate" style="max-width:150px">
            <button type="button" class="btn btn-primary" onclick="onSearchClick()">Поиск</button>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                Дата
            </th>
            <th>
                Важность
            </th>
            <th>
                Пользователь
            </th>
            <th>
                Сообщение
            </th>
            <th>
                Дополнительная информация
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.DBLogs != null){
            @foreach (var item in Model.DBLogs)
            {
                <tr>
                    <td>
                        @item.DateTime.ToString("dd.MM.yyyy HH:mm:ss")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Level)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.User)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Message)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AdditionalInfo)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
@if (Model.PageInfo != null)
{
    <nav aria-label="...">
        <ul class="pagination pagination-sm">
            @if (Model.PageInfo.PageNumber == 1){
                <li class="page-item disabled">
                    <a class="page-link" href="#">
                        <span aria-hidden="true">«</span>
                        <span class="sr-only">Previous</span>
                    </a>
                </li>
            }
            else{
                <li class="page-item">
                    <a class="page-link" href="#" onclick="onPageClick(event, @Model.PageInfo.PageNumber - 1)">
                        <span aria-hidden="true">«</span>
                        <span class="sr-only">Previous</span>
                    </a>
                </li>
            }
            @{
                var firstPage = 1;
                if (Model.PageInfo.PageNumber - 2 > 0){
                    firstPage = Model.PageInfo.PageNumber - 2;
                }
                var lastPage = Model.PageInfo.TotalPages;
                if (Model.PageInfo.PageNumber + 2 < Model.PageInfo.TotalPages){
                    lastPage = Model.PageInfo.PageNumber + 2;
                }
            }
            @for (var currentPage = firstPage; currentPage <= lastPage; currentPage++)
            {
                if (currentPage == Model.PageInfo.PageNumber)
                {
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">
                            @currentPage
                            <span class="sr-only">(current)</span>
                        </span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="#" onclick="onPageClick(event, @currentPage)">@currentPage</a>
                    </li>
                }
            }
            @if (Model.PageInfo.PageNumber == Model.PageInfo.TotalPages){
                <li class="page-item disabled">
                    <a class="page-link" href="#">
                        <span aria-hidden="true">»</span>
                        <span class="sr-only">Next</span>
                    </a>
                </li>
            }
            else{
                <li class="page-item">
                    <a class="page-link" href="#" onclick="onPageClick(event, @Model.PageInfo.PageNumber + 1)">
                        <span aria-hidden="true">»</span>
                        <span class="sr-only">Next</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

<script>
    const params = new Proxy(new URLSearchParams(window.location.search), {
        get: (searchParams, prop) => searchParams.get(prop),
    });
    document.getElementById('StartDate').value = params.startDate;
    document.getElementById('EndDate').value = params.endDate;
    let page = params.page;
    function onSearchClick(){
        window.location = '/DBLogs?startDate='+document.getElementById('StartDate').value+'&endDate='+document.getElementById('EndDate').value;
    }
    function onPageClick(event, page){
        event.preventDefault();
        let url = '/DBLogs';
        if (params.startDate != undefined && params.endDate != undefined){
            url += '?startDate='+document.getElementById('StartDate').value+'&endDate='+document.getElementById('EndDate').value;
            url += '&page='+page;
        }
        else{
            url += '?page='+page;
        }
        window.location = url;
    }
</script>