@model AVBDelivery.ViewModels.OrganizationEditViewModel

@{
    ViewData["Title"] = "Организация";
}

<h1>Организация</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="SaveEditedOrganization" method="post" asp-controller="Organizations">
    <input type="hidden" asp-for="UserId"/>
    <input type="hidden" asp-for="OrganizationId"/>
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input type="text" asp-for="Name" class="form-control" value="@Model.Name" />
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber" class="control-label">Номер телефона</label>
        <input type="tel" asp-for="PhoneNumber" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Inn" class="control-label">ИНН</label>
        <input type="text" asp-for="Inn" class="form-control" value="@Model.Inn" />
    </div>
    <div class="form-group">
        <label asp-for="DeliveryAddress" class="control-label">Адрес</label>
        <input type="text" asp-for="DeliveryAddress" class="form-control" value="@Model.DeliveryAddress" />
    </div>
    <div class="form-group">
        <label asp-for="DeliveryTime" class="control-label">Время доставки в будние</label>
        <input type="text" asp-for="DeliveryTime" class="form-control" value="@Model.DeliveryTime" />
    </div>
    <div class="form-group">
        <label asp-for="DeliveryWeekendTime" class="control-label">Время доставки выходные</label>
        <input type="text" asp-for="DeliveryWeekendTime" class="form-control" value="@Model.DeliveryWeekendTime" />
    </div>
    <div class="form-group">
        <label asp-for="MinimalSum" class="control-label">Минимальная сумма доставки</label>
        <input type="number" asp-for="MinimalSum" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Comment" class="control-label">Комментарий</label>
        <input type="text" asp-for="Comment" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Discount" class="control-label">Скидка</label>
        <div class="input-group">
            <input type="number" asp-for="Discount" class="form-control" min="0" max="100" step="0.01" />
            <div class="input-group-append">
                <span class="input-group-text">%</span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="MenuId" class="control-label">Меню</label>
        <select asp-for="MenuId" class="form-control" asp-items="@(new SelectList(Model.AllMenus, "Id", "Name"))">
            <option value="">— Показывать всё меню —</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="Note" class="control-label">Примечание</label>
        @if (Model.AllNotes != null && Model.AllNotes.Any())
        {
            foreach (var note in Model.AllNotes)
            {
                <div class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           name="SelectedNoteIds"
                           value="@note.Id"
                           id="note_@note.Id"
                           @(Model.Notes.Select(n => n.Id).Contains(note.Id) ? "checked" : "") />
                    <label class="form-check-label" for="note_@note.Id">
                        @note.Value
                    </label>
                </div>
            }
        }
        else
        {
            <p>Нет доступных примечаний</p>
        }
    </div>

    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
    </div>
</form>
