@model AVBDelivery.ViewModels.LoginViewModel


    <!-- Log In page -->
    <div class="container-md" >
        <div class="row d-flex justify-content-center">
            <div class="col-12 align-self-center">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 mx-auto">
                            <div class="card">
                                <div class="card-body p-0 auth-header-box">
                                    <div class="text-center p-3">
                                        <a href="/" class="logo logo-admin">
                                            <img src="~/assets/images/logo-yellow-cropped.svg" height="50" alt="logo" class="auth-logo">
                                        </a>
                                        <h4 class="mt-3 mb-1 fw-semibold text-muted font-18">Добро пожаловать</h4>
                                        <p class="text-muted  mb-0">Войдите, чтобы сделать заказ.</p>
                                    </div>
                                </div>
                                <div class="card-body pt-0">
                                    <form class="my-4" method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">
                                        <div asp-validation-summary="ModelOnly"></div>
                                        <div class="form-group mb-2">
                                            <label class="form-label" asp-for="Email">Логин</label>
                                            <input asp-for="Email" class="form-control" placeholder="Имя пользователя" />
                                            <span asp-validation-for="Email"></span>
                                        </div><!--end form-group-->

                                        <div class="form-group">
                                            <label class="form-label" asp-for="Password">Пароль</label>
                                            <input asp-for="Password" class="form-control" name="password" id="userpassword" placeholder="Пароль">
                                            <span asp-validation-for="Password"></span>
                                        </div><!--end form-group-->

                                        <div class="form-group row mt-3">
                                            <div class="col-sm-6">
                                                <div class="form-check form-switch form-switch-success">
                                                    <input class="form-check-input" asp-for="RememberMe" id="customSwitchSuccess">
                                                    <label class="form-check-label" asp-for="RememberMe"></label>
                                                </div>
                                            </div><!--end col-->
                                            <div class="col-sm-6 text-end">
                                                <a href="auth-recover-pw.html" class="text-muted font-13"><i class="dripicons-lock"></i> Забыли пароль?</a>
                                            </div><!--end col-->
                                        </div><!--end form-group-->

                                        <div class="form-group mb-0 row">
                                            <div class="col-12">
                                                <div class="d-grid mt-3">
                                                    <button class="btn btn-primary" type="submit">Войти <i class="fas fa-sign-in-alt ms-1"></i></button>
                                                </div>
                                            </div><!--end col-->
                                        </div> <!--end form-group-->
                                    </form><!--end form-->
                                    @* <div class="m-3 text-center text-muted">
                                        <p class="mb-0">Ещё не зарегистрированы?  <a href="/Account/Register" class="text-primary ms-2">Зарегистрироваться</a></p>
                                    </div> *@
                                    <hr class="hr-dashed mt-4">
                                </div><!--end card-body-->
                            </div><!--end card-->
                        </div><!--end col-->
                    </div><!--end row-->
                </div><!--end card-body-->
            </div><!--end col-->
        </div><!--end row-->
    </div><!--end container-->
