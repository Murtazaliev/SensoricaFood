@model AVBDelivery.Models.IikoServer

@{
    ViewData["Title"] = "Create";
}

<h1>Создать подключение</h1>

<h4>iiko сервер</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" id="form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="UseHttps" id="iikoUseHttps" /> https
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Server" class="control-label">Адрес сервера</label>
                <input asp-for="Server" class="form-control" id="iikoServer" />
                <span asp-validation-for="Server" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Port" class="control-label">Порт</label>
                <input asp-for="Port" class="form-control" id="iikoPort" />
                <span asp-validation-for="Port" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Path" class="control-label">Путь</label>
                <input asp-for="Path" class="form-control" id="iikoPath" />
                <span asp-validation-for="Path" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="iikoLogin" class="control-label">Логин iiko</label>
                <input asp-for="iikoLogin" class="form-control" id="iikoLogin" autocomplete="new-login" />
                <span asp-validation-for="iikoLogin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="iikoPassword" class="control-label">Пароль iiko</label>
                <input asp-for="iikoPassword" class="form-control" type=password id="iikoPassword" autocomplete="new-password" />
                <span asp-validation-for="iikoPassword" class="text-danger"></span>
            </div>

            <div id="alert2">

            </div>


            <div class="form-group">
                <input value="Тест подключения" type="button" class="btn btn-success" onclick="TestConnection();" />
                <input type="submit" value="Создать" id="create" class="btn btn-primary" disabled="disabled" />
            </div>
        </form>
    </div>
</div>
<script>
    async function TestConnection() {
        let bodyJson = JSON.stringify({
            UseHttps: Boolean(document.getElementById("iikoUseHttps").checked),
            Server: document.getElementById("iikoServer").value,
            Port: document.getElementById("iikoPort").value,
            Path: document.getElementById("iikoPath").value,
            iikoLogin: document.getElementById("iikoLogin").value,
            iikoPassword: document.getElementById("iikoPassword").value,
        });
        const response = await fetch("/IikoServers/PostTest", {
            method: "POST",
            headers: { "Accept": "application/json", "Content-Type": "application/json" },
            body: bodyJson
        });
        console.log(response);
        if (response.ok != true) {
            document.getElementById("alert2").innerHTML = '<div class="alert alert-danger alert-dismissible fade show border-0 b-round" role="alert"><strong>Опаньки!</strong> 😢 Где-то мы ошиблись.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
        }


        if (response.ok === true) {
            console.log("Получили успешный ответ.");
            const result = await response.json();
            console.log(result);
            if (result == "Ok") {
                document.getElementById("alert2").innerHTML = '<div class="alert alert-primary alert-dismissible fade show border-0 b-round" role="alert"><strong>Отлично!</strong> 👍 Все настройки корректны.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
                document.getElementById('create').disabled = false;
            }
            else {
                document.getElementById("alert2").innerHTML = '<div class="alert alert-danger alert-dismissible fade show border-0 b-round" role="alert"><strong>Опаньки!</strong> 😢 Где-то мы ошиблись.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>';
            }

        }







    }
</script>
<div>
    <a asp-action="Index">К списку серверов</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
